{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "args": true, "name": "binaries/renpy-to-ps3", "sidecar": true }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "args": true, "name": "binaries/renpy-to-ps3", "sidecar": true }]
    }
  ]
}
